# Position
anchor=top-right
margin=20
width=420
height=110

# Colors
background-color=#1c171cee
text-color=#fad7c4
border-color=#ea8253

# Font
font=UbuntuMono Nerd Font 11

# Shape
border-size=2
border-radius=8
padding=10

# Shadow (makes the glass effect)
outer-margin=0

# Behavior
default-timeout=4500
max-visible=3
ignore-timeout=0

# Layout
format=<b>%s</b>\n%b
